.DS_Store
# bez lomítka: se `node_modules/` git ignoruje jen adresář, ne symlink
# téhož jména — přesně tak se do repa dostal odkaz node_modules -> sám
# na sebe (commit 2e1348a).
node_modules
public/
static/css/main.css
static/js/app.js
static/js/graph-app.js
data/generated/
static/search-index.json
# Registrové exporty pro /data/ a SQL konzoli — generuje build:data-exports
# ze stejných front matter jako stránky; stejný důvod jako u search-indexu.
static/data/
.build-lock/

# Playwright artefakty (T-021) — reporty a trace z padlych behu
test-results/
playwright-report/

# Intake processor fixture-run scratch output (npm run intake:fixture,
# docs/missions/intake/PHASE_002.md §21.2) — never tracked, never
# produced by a real GitHub event.
.tmp/intake/

# Cache stažených stránek zdrojů (npm run sources:detect-family). Cizí
# HTML, ne zdroj pravdy — kdykoli smazatelná, detektor si ho stáhne znovu.
.tmp/source-family/

# Cache měsíčních dumpů registru smluv (npm run screening:public-money).
# Stovky MB stažených otevřených dat — cache, ne zdroj pravdy; kdykoli
# smazatelná, skript si je stáhne znovu.
.tmp/public-money/

# Official-document archive Zone B. The normal location is a sibling tree
# outside this repository (VOMASTE_JUSTICE_ARCHIVE_ROOT), but these root-level
# guards prevent an accidental local override from ever being staged.
/vomaste-archive/
/justice-api-metadata/
/sbirka-listin/
/court-noticeboards-raw/

# Zbytky po migraci na kanonický JSON model (T-028): per-dossier stats.toml
# generoval dřívější generate-stats.mjs, dnes je počty vlastní view modely
# (scripts/data/build-view-models.mjs). Nikdo je už negeneruje ani nečte —
# jen se v pracovních kopiích válely od doby před migrací a `git add -A` je
# opakovaně vtahoval do stagingu. Pravidlo je tu proto, aby se mrtvý
# artefakt nevrátil do gitu omylem.
data/dossiers/*/stats.toml

# Prismatic Platform integration (docs/adr/prismatic-platform-integration.md,
# AUTH-2026-08-05-PLATFORM-SCOPE in AGENTS.md). Only var/prismatic-runs/ is
# raw/ignored — data/staging, data/review and data/imports are sanitized,
# reviewable Git-tracked zones by design and must NOT be added here.
var/prismatic-runs/
.prismatic-local.toml
