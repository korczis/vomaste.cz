#!/usr/bin/env bash
# Po `git pull`/`git merge` upozorni, že vygenerované vstupy chybí nebo
# zestárly — a na masteru dodělej totéž "commit = push = deploy", co dělá
# post-commit.
#
# DVA hooky v jednom souboru, protože git merge/pull historicky sem patří,
# ne do post-commit: git fetch+merge (což je i git pull) spouští
# pre-merge-commit/post-merge, NIKDY pre-commit/post-commit. Objeveno
# 2026-08-06 při normálním coop mergi (`git merge --no-ff task/T-###`
# na masteru) — merge commit prošel bez povšimnutí, auto-push se nespustil
# a musel se pushnout ručně, přesně to co má tenhle mechanismus odstranit.
#
# 1) Generated-inputs warning (původní, beze změny): data/generated/* a
#    data/dossiers/*/stats.toml jsou v .gitignore — pull je nikdy nepřinese.
#    Bez tohohle upozornění se to projeví až tím, že `zola serve` spadne na
#    load_data hláškou z hloubi base.html, ze které není poznat, že chybí
#    krok pipeline. Hook jen VAROVÁ, nespouští generátory sám: pull nemá
#    bez vyzvání přepisovat pracovní strom ani zabírat minuty CPU.
# 2) Auto-push (nové): sdílená logika v .githooks/lib/auto-push-master.sh
#    (tatáž, kterou volá post-commit) — self-gatuje na branch master,
#    COOP_NO_AUTOPUSH, probíhající rebase/merge atd., takže je bezpečné
#    volat ji odsud bezpodmínečně. Běží AŽ PO warningu výše, protože je
#    pomalá (plný npm run build) a warning je rychlý a má smysl i mimo
#    master.
set -u
node scripts/build/require-generated.mjs --quiet 2>/dev/null || {
  echo ""
  echo "⚠  Po pullu chybí vygenerované vstupy (nejsou v gitu)."
  echo "   Spusť:  npm run dev     (generátory + živý server)"
  echo "   Detail: node scripts/build/require-generated.mjs"
  echo ""
}

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/auto-push-master.sh
source "$HOOK_DIR/lib/auto-push-master.sh"
auto_push_master "post-merge"
exit 0
