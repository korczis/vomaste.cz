{
  "name": "vomaste-cz",
  "version": "1.0.0",
  "private": true,
  "description": "vomaste.cz static site (Zola + Tailwind + Alpine.js)",
  "scripts": {
    "postinstall": "node scripts/setup/install-git-hooks.mjs",
    "hooks:install": "node scripts/setup/install-git-hooks.mjs",
    "test": "node --test scripts/build/*.test.mjs scripts/dossier/*.test.mjs scripts/data/*.test.mjs scripts/migrations/*.test.mjs scripts/lint/*.test.mjs scripts/ui/*.test.mjs scripts/ci/*.test.mjs scripts/osint/*.test.mjs scripts/intake/*.test.mjs scripts/intake/matching/*.test.mjs scripts/intake/risk/*.test.mjs scripts/intake/preflight/*.test.mjs",
    "css:build": "tailwindcss -i ./static/css/input.css -o ./static/css/main.css --minify",
    "css:watch": "tailwindcss -i ./static/css/input.css -o ./static/css/main.css --watch",
    "js:build": "esbuild assets/js/app.js assets/js/graph-app.js --bundle --minify --target=es2020 --outdir=static/js",
    "data:validate": "node scripts/data/validate.mjs",
    "dossier:scaffold": "node scripts/data/scaffold-dossier.mjs",
    "data:compile": "node scripts/data/check.mjs",
    "data:views": "node scripts/data/build-view-models.mjs",
    "data:generate-content": "node scripts/data/generate-zola-content.mjs",
    "data:sync-content": "node scripts/data/sync-content.mjs",
    "data:check-generated": "node scripts/data/check-generated.mjs",
    "data:check-generated:content": "node scripts/data/check-generated.mjs --content",
    "data:build": "npm run data:validate && npm run data:compile && npm run data:views && npm run data:generate-content && npm run data:sync-content && npm run data:check-generated:content",
    "validate:authorization": "node scripts/dossier/validate-authorization.mjs",
    "verify:authorization-log": "node scripts/dossier/verify-authorization-log-append-only.mjs",
    "authorization:anchor": "node scripts/dossier/anchor-authorization-log.mjs",
    "validate:dossier-types": "node scripts/dossier/validate-dossier-types.mjs",
    "build:navigation": "node scripts/dossier/build-navigation.mjs",
    "build:secondary-providers": "node scripts/dossier/build-secondary-providers.mjs",
    "validate:navigation": "node scripts/dossier/validate-navigation.mjs",
    "validate:concepts": "node scripts/dossier/validate-concepts.mjs",
    "validate:entity-types": "node scripts/dossier/validate-entity-types.mjs",
    "build:routes": "node scripts/dossier/build-route-manifest.mjs",
    "build:search-index": "node scripts/dossier/build-search-index.mjs",
    "build:data-exports": "node scripts/dossier/build-data-exports.mjs",
    "build:jsonld-exports": "node scripts/dossier/build-jsonld-exports.mjs",
    "verify:export": "node scripts/dossier/verify-export.mjs",
    "build:graph-projections": "node scripts/dossier/build-graph-projections.mjs",
    "validate:graph-projections": "node scripts/dossier/validate-graph-projections.mjs",
    "generate:candidates": "node scripts/dossier/generate-authorization-candidates.mjs",
    "generate:discovery-log": "node scripts/dossier/generate-discovery-log.mjs",
    "verify:anchors": "node scripts/dossier/verify-anchors.mjs",
    "lint:hardcoded-records": "node scripts/lint/lint-hardcoded-records.mjs",
    "lint:generated-content": "node scripts/lint/lint-generated-content.mjs",
    "lint:historical-coupling": "node scripts/lint/lint-historical-coupling.mjs",
    "check:workflow-parity": "node scripts/ci/check-workflow-parity.mjs",
    "lint:source-outlets": "node scripts/lint/lint-source-outlets.mjs",
    "lint:component-reuse": "node scripts/lint/lint-component-reuse.mjs",
    "verify:jsonld": "node scripts/dossier/verify-jsonld.mjs",
    "verify:full-pages": "node scripts/dossier/verify-full-pages.mjs",
    "authorize:entity": "node scripts/dossier/authorize-entity.mjs",
    "build:government-roster": "node scripts/dossier/build-government-roster.mjs",
    "build": "node scripts/build/pipeline.mjs build",
    "check": "node scripts/build/pipeline.mjs check",
    "dev": "npm run validate:authorization && npm run validate:dossier-types && npm run build:entity-type-sections && npm run build:routes && npm run build:navigation && npm run validate:navigation && npm run build:data-exports && npm run build:graph-projections && npm run validate:graph-projections && npm run build:jsonld-exports && npm run data:metrics && npm run validate:navigation-metrics && npm run build:search-index && npm run generate:candidates && npm run generate:discovery-log && npm run css:build && npm run js:build && zola serve",
    "data:metrics": "node scripts/data/build-navigation-metrics.mjs",
    "validate:navigation-metrics": "node scripts/data/build-navigation-metrics.mjs --check",
    "verify:navigation-counts": "node scripts/data/verify-navigation-counts.mjs",
    "build:entity-type-sections": "node scripts/dossier/build-entity-type-sections.mjs",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:benchmark": "RUN_GRAPH_BENCHMARK=1 playwright test tests/e2e/graph-benchmark.spec.mjs --project=desktop",
    "benchmark:graph": "node scripts/dossier/benchmark-graph.mjs",
    "validate:directory-index": "node scripts/dossier/validate-directory-index.mjs",
    "preflight": "node scripts/build/require-generated.mjs",
    "serve": "node scripts/build/require-generated.mjs --quiet || npm run generate:all ; zola serve",
    "generate:all": "npm run build:entity-type-sections && npm run build:routes && npm run build:navigation && npm run build:secondary-providers && npm run build:data-exports && npm run build:graph-projections && npm run build:jsonld-exports && npm run data:metrics && npm run build:search-index && npm run generate:candidates && npm run generate:discovery-log && npm run css:build && npm run js:build",
    "intake:process": "node scripts/intake/process-issue.mjs",
    "intake:validate": "node scripts/intake/validate-manifest.mjs",
    "intake:validate-form": "node scripts/ci/validate-issue-forms.mjs",
    "intake:validate-workflow": "node scripts/ci/validate-intake-workflow.mjs",
    "intake:fixture": "node scripts/intake/run-fixture.mjs",
    "intake:preflight-fixture": "node scripts/intake/run-preflight-fixture.mjs",
    "intake:e2e-fixture": "node scripts/intake/run-e2e-fixture.mjs",
    "intake:github-event": "node scripts/intake/process-github-event.mjs",
    "intake:publish-fixture": "node scripts/intake/run-publish-fixture.mjs",
    "test:intake": "node --test scripts/intake/*.test.mjs scripts/intake/matching/*.test.mjs scripts/intake/risk/*.test.mjs scripts/intake/preflight/*.test.mjs scripts/intake/adapters/*.test.mjs scripts/intake/github/*.test.mjs",
    "test:intake:matching": "node --test scripts/intake/matching/*.test.mjs",
    "test:intake:risk": "node --test scripts/intake/risk/*.test.mjs",
    "test:intake:preflight": "node --test scripts/intake/preflight/*.test.mjs",
    "test:intake:form": "node --test scripts/intake/issue-form-compatibility.test.mjs scripts/ci/validate-issue-forms.test.mjs scripts/ci/issue-templates.test.mjs",
    "test:intake:e2e": "node --test scripts/intake/run-e2e-fixture.test.mjs",
    "test:intake:github": "node --test scripts/intake/adapters/*.test.mjs scripts/intake/process-github-event.test.mjs scripts/intake/publish-github-result.test.mjs scripts/intake/github/*.test.mjs scripts/intake/validate-artifact-safety.test.mjs",
    "intake:index": "node scripts/intake/build-matching-index.mjs",
    "intake:match-fixture": "node scripts/intake/process-issue.mjs --event tests/fixtures/intake/valid-new-dossier.json --output-dir .tmp/intake/match-fixture --generated-at 2026-08-02T00:00:00.000Z --repository-commit 0000000000000000000000000000000000000f --overwrite"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "ajv": "^8.20.0",
    "alpinejs": "^3.15.12",
    "autoprefixer": "^10.4.24",
    "esbuild": "^0.28.1",
    "flowbite": "^4.0.2",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "js-yaml": "^5.2.3",
    "jsonld": "^8.3.3",
    "postcss": "^8.5.6",
    "sigma": "^3.0.3",
    "tailwindcss": "^3.4.19"
  }
}
