{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vomaste.cz/schemas/canonical/vocabulary.schema.json",
  "title": "Mini-schéma slovníku (data/dossiers/_shared/vocabularies/*.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "values"],
  "properties": {
    "$schema": { "const": "https://vomaste.cz/schemas/canonical/vocabulary.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "$comment": { "type": "string" },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$comment": "Slovníky jsou deskriptivní inventáře hodnot skutečně použitých v repu (fáze B) — hodnoty se sem nikdy nevymýšlejí. Uzavřené množiny navíc vynucují enumy v _defs.schema.json; synchronizaci obou míst hlídá scripts/data/validate-shape.test.mjs."
}
