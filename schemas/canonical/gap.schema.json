{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vomaste.cz/schemas/canonical/gap.schema.json",
  "title": "Kanonický záznam Gap (data/dossiers/<slug>/gaps/gap-##.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "@context", "@id", "@type", "recordType", "identifier", "dossier", "title", "description", "priority", "checked", "claims", "subjects", "content", "order"],
  "properties": {
    "$schema": { "const": "https://vomaste.cz/schemas/canonical/gap.schema.json" },
    "schemaVersion": { "const": 1 },
    "@context": { "const": "https://vomaste.cz/context/v1.jsonld" },
    "@id": { "$ref": "_defs.schema.json#/$defs/gapGlobalId" },
    "@type": { "const": "vomaste:Gap" },
    "recordType": { "const": "gap" },
    "identifier": { "$ref": "_defs.schema.json#/$defs/gapId" },
    "dossier": { "$ref": "_defs.schema.json#/$defs/dossierRef" },
    "title": { "type": "string", "minLength": 1 },
    "description": {
      "type": "string",
      "minLength": 1,
      "$comment": "Redakční pravidla 6/8 (AGENTS.md): mezera je otevřená otázka, nikdy konstatování viny/neviny/nepravdivosti — neutralitu textu tvarové schéma vynutit neumí, hlídá ji redakce."
    },
    "priority": { "$ref": "_defs.schema.json#/$defs/gapPriority" },
    "checked": {
      "$ref": "_defs.schema.json#/$defs/isoDate",
      "$comment": "Datum poslední kontroly mezery proti zdrojům."
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "_defs.schema.json#/$defs/claimRef" }
    },
    "subjects": { "$ref": "_defs.schema.json#/$defs/subjects" },
    "status": {
      "type": "string",
      "enum": ["open", "closed"],
      "$comment": "Volitelné nové strukturované pole (dnes uzavření mezery zaznamenává jen updates.toml closed_gaps); chybějící status = open."
    },
    "closedAt": { "$ref": "_defs.schema.json#/$defs/isoDate" },
    "content": { "$ref": "_defs.schema.json#/$defs/contentBlocks" },
    "order": { "type": "integer", "minimum": 0 }
  }
}
