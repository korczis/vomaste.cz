{
  "@context": {
    "@version": 1.1,
    "vomaste": "https://vomaste.cz/ns#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "schemaVersion": "vomaste:schemaVersion",
    "recordType": "vomaste:recordType",
    "identifier": "schema:identifier",
    "dossier": { "@id": "vomaste:dossier", "@type": "@id" },

    "title": "schema:name",
    "description": "schema:description",
    "text": "schema:text",
    "summary": "schema:abstract",
    "label": "vomaste:label",
    "status": "vomaste:status",
    "statusLabel": "vomaste:statusLabel",
    "url": { "@id": "schema:url", "@type": "@id" },
    "archiveUrl": { "@id": "vomaste:archiveUrl", "@type": "@id" },
    "availability": "vomaste:availability",

    "published": { "@id": "schema:datePublished", "@type": "xsd:date" },
    "retrieved": { "@id": "vomaste:retrieved", "@type": "xsd:date" },
    "checked": { "@id": "vomaste:checked", "@type": "xsd:date" },
    "checkedAt": { "@id": "vomaste:checked", "@type": "xsd:date" },
    "createdAt": { "@id": "schema:dateCreated", "@type": "xsd:date" },
    "closedAt": { "@id": "vomaste:closedAt", "@type": "xsd:date" },
    "updated": { "@id": "schema:dateModified", "@type": "xsd:date" },
    "reviewedAt": { "@id": "vomaste:reviewedAt", "@type": "xsd:date" },
    "snapshotDate": { "@id": "vomaste:snapshotDate", "@type": "xsd:date" },
    "date": { "@id": "vomaste:date", "@type": "xsd:date" },

    "claims": { "@id": "vomaste:claims", "@type": "@id", "@container": "@set" },
    "sources": { "@id": "vomaste:sources", "@type": "@id", "@container": "@set" },
    "cases": { "@id": "vomaste:cases", "@type": "@id", "@container": "@set" },
    "subjects": { "@id": "vomaste:subjects", "@container": "@set" },
    "subjectOf": { "@id": "schema:subjectOf", "@type": "@id", "@container": "@set" },

    "content": { "@id": "vomaste:content", "@container": "@list" },
    "contentBlocks": { "@id": "vomaste:contentBlocks", "@container": "@list" },
    "type": "vomaste:blockType",
    "value": "vomaste:value",
    "attribution": "vomaste:attribution",
    "source": { "@id": "vomaste:blockSource", "@type": "@id" },
    "items": { "@id": "vomaste:items", "@container": "@list" },
    "entries": { "@id": "vomaste:timelineEntries", "@type": "@json" },
    "order": "vomaste:order",
    "period": "vomaste:period",
    "anchor": "vomaste:anchor",

    "outlet": "vomaste:outlet",
    "sourceType": "vomaste:sourceType",
    "sourceFamily": "vomaste:sourceFamily",
    "citationFingerprint": "vomaste:citationFingerprint",

    "relationId": "vomaste:relationId",
    "relationType": "vomaste:relationType",
    "sourceEntity": { "@id": "vomaste:from", "@type": "@id" },
    "targetEntity": { "@id": "vomaste:to", "@type": "@id" },
    "directed": "vomaste:directed",

    "entityId": "vomaste:entityId",
    "entityType": "vomaste:entityType",
    "alternateNames": { "@id": "schema:alternateName", "@container": "@set" },
    "role": "vomaste:role",
    "publicationRole": "vomaste:publicationRole",
    "dossierEnabled": "vomaste:dossierEnabled",
    "dossierStatus": "vomaste:dossierStatus",
    "coverageState": "vomaste:coverageState",
    "dossiers": { "@id": "vomaste:inDossier", "@container": "@set" },
    "externalIds": { "@id": "vomaste:externalIds", "@type": "@json" },
    "routeAliases": { "@id": "vomaste:routeAliases", "@container": "@set" },

    "slug": "vomaste:slug",
    "dossierType": "vomaste:dossierType",
    "canonicalDossier": "vomaste:canonicalDossier",
    "subject": "vomaste:subject",
    "language": "schema:inLanguage",
    "aliases": { "@id": "vomaste:aliases", "@container": "@set" },
    "navigationVisible": "vomaste:navigationVisible",
    "aggregates": { "@id": "vomaste:aggregates", "@container": "@set" },
    "authorization": { "@id": "vomaste:authorization", "@type": "@json" },
    "seo": { "@id": "vomaste:seo", "@type": "@json" },
    "priority": "vomaste:priority",

    "addedClaims": { "@id": "vomaste:addedClaims", "@type": "@id", "@container": "@set" },
    "updatedClaims": { "@id": "vomaste:updatedClaims", "@type": "@id", "@container": "@set" },
    "addedGaps": { "@id": "vomaste:addedGaps", "@type": "@id", "@container": "@set" },
    "closedGaps": { "@id": "vomaste:closedGaps", "@type": "@id", "@container": "@set" },
    "reviewedSources": { "@id": "vomaste:reviewedSources", "@type": "@id", "@container": "@set" }
  }
}
